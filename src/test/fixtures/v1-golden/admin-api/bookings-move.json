{
  "changed (booking 3 is not at the slot the admin saw)": {
    "body": {
      "error": {
        "code": "changed",
        "message": "This booking was changed by someone else. Reload the page."
      }
    },
    "headers": {
      "cache-control": "no-store",
      "content-type": "application/json"
    },
    "status": 409
  },
  "invalid_input (nothing sent)": {
    "body": {
      "error": {
        "code": "invalid_input",
        "message": "Check the highlighted fields."
      },
      "fields": {
        "fromSlot": "Send the slot the booking is in.",
        "toSlot": "Choose a slot."
      }
    },
    "headers": {
      "cache-control": "no-store",
      "content-type": "application/json"
    },
    "status": 400
  },
  "invalid_slot (target is no slot)": {
    "body": {
      "error": {
        "code": "invalid_slot",
        "message": "That time isn't one of this event's slots."
      }
    },
    "headers": {
      "cache-control": "no-store",
      "content-type": "application/json"
    },
    "status": 400
  },
