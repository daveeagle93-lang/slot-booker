// Worker config (one Worker that serves the API and, through the ASSETS binding, the static site in public/).
// No club details or secrets live here. The "Deploy to Cloudflare" button reads this file directly: it creates
// a database in the club's own account, replaces the placeholder database_ids below, and applies the migrations
// (the `deploy` script in package.json). Secrets go in .dev.vars (local) or Worker secrets (deployed), never here.
//
// Developers deploying by hand put their own database_ids and vars in the git-ignored account.local.json;
// `npm run configure` generates a git-ignored wrangler.json from this file plus that one, and Wrangler reads it
// instead (docs/deploying.md, step 3). Do not edit this file for your account.
//
// Two databases: the top-level d1_databases is production (and what local dev and
// the tests use); env.preview.d1_databases is a separate database for the preview
// environment. d1_databases and vars are non-inheritable, so each block is spelled out in full.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "slot-booker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-28",
  // run_worker_first: the Worker sees these paths before the static files, so the admin guards, the API and
  // the event page cannot be bypassed by a static file or served around the Worker. Everything else (scripts,
  // styles, icons) is served straight from public/. src/test/wrangler-config.test.ts pins this list.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/e/*", "/api/*", "/admin", "/admin/*"]
  },
  // No per-version preview URLs: they would serve the whole app, admin included, on extra hostnames.
  "preview_urls": false,
  // A fresh deployment signs admins in with a password. Anyone using Cloudflare Access changes ADMIN_AUTH (and adds
  // ACCESS_TEAM_DOMAIN and ACCESS_AUD) in their own copy of this file, or as docs/admin-auth.md describes.
  // Values here overwrite ones set in the Cloudflare dashboard on every deploy. vars is not inherited by env.preview.
  "vars": { "ADMIN_AUTH": "password" },
  "d1_databases": [
    {
      "binding": "DB",
      // The test global-setup migrates this name locally: do not rename it.
      "database_name": "slot-booker-db",
      // Placeholder: replaced by provisioning.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "preview": {
      "vars": { "ADMIN_AUTH": "password" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "slot-booker-db-preview",
          // Placeholder: replaced by provisioning. Must differ from production's.
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
