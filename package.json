{
  "name": "slot-booker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Lightweight slot-booking app for small clubs, on the Cloudflare free tier.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.public.json",
    "dev": "wrangler pages dev",
    "db:migrate:local": "wrangler d1 migrations apply slot-booker-db --local",
    "seed": "node scripts/seed.ts",
    "seed:local": "node scripts/seed.ts --local",
    "generate-admin-secret": "node scripts/generate-admin-secret.ts",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "happy-dom": "^20.14.5",
    "ical.js": "^2.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
